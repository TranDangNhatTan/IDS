// SAFETY TEMPLATE ONLY - DO NOT ADD TO THE PROJECT UNTIL EVERY PACKAGE PIN
// HAS BEEN COPIED FROM THE ACG525 CORE + CARRIER BOARD SCHEMATICS.
//
// Replace every <...> token. Both LAN8720 modules and the FPGA logic must
// share the same 50 MHz RMII reference clock.

IO_LOC "rmii_ref_clk" <FPGA_PIN>;
IO_PORT "rmii_ref_clk" IO_TYPE=LVCMOS33;

IO_LOC "ext_rst_n" <FPGA_PIN>;
IO_PORT "ext_rst_n" PULL_MODE=UP IO_TYPE=LVCMOS33;

IO_LOC "phy1_rxd[0]" <FPGA_PIN>;
IO_LOC "phy1_rxd[1]" <FPGA_PIN>;
IO_LOC "phy1_crs_dv" <FPGA_PIN>;
IO_LOC "phy1_txd[0]" <FPGA_PIN>;
IO_LOC "phy1_txd[1]" <FPGA_PIN>;
IO_LOC "phy1_tx_en" <FPGA_PIN>;
IO_LOC "phy1_rst_n" <FPGA_PIN>;

IO_LOC "phy2_rxd[0]" <FPGA_PIN>;
IO_LOC "phy2_rxd[1]" <FPGA_PIN>;
IO_LOC "phy2_crs_dv" <FPGA_PIN>;
IO_LOC "phy2_txd[0]" <FPGA_PIN>;
IO_LOC "phy2_txd[1]" <FPGA_PIN>;
IO_LOC "phy2_tx_en" <FPGA_PIN>;
IO_LOC "phy2_rst_n" <FPGA_PIN>;

IO_PORT "phy1_rxd[0]" "phy1_rxd[1]" "phy1_crs_dv" IO_TYPE=LVCMOS33;
IO_PORT "phy1_txd[0]" "phy1_txd[1]" "phy1_tx_en" "phy1_rst_n" IO_TYPE=LVCMOS33;
IO_PORT "phy2_rxd[0]" "phy2_rxd[1]" "phy2_crs_dv" IO_TYPE=LVCMOS33;
IO_PORT "phy2_txd[0]" "phy2_txd[1]" "phy2_tx_en" "phy2_rst_n" IO_TYPE=LVCMOS33;

// Optional debug LEDs. Leave status[] unconstrained if no LEDs are needed.
// IO_LOC "status[0]" <FPGA_PIN>;

IO_LOC "clk" T9;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "rst_n" B16;
IO_PORT "rst_n" IO_TYPE=LVCMOS15 PULL_MODE=UP;
// Pi GPIO14/TXD0 -> P6-GPIO0 -> FPGA C17.
IO_LOC "uart_feature_rx" C17;
IO_PORT "uart_feature_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
// Onboard CH9102F USB UART: RX V7 (model/debug), TX V8 (result/debug).
IO_LOC "uart_usb_rx" V7;
IO_PORT "uart_usb_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "uart_usb_tx" V8;
IO_PORT "uart_usb_tx" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=UP;
IO_LOC "led[0]" D14; IO_LOC "led[1]" C14; IO_LOC "led[2]" B9; IO_LOC "led[3]" A9;
IO_PORT "led[0]" IO_TYPE=LVCMOS15 DRIVE=4;
IO_PORT "led[1]" IO_TYPE=LVCMOS15 DRIVE=4;
IO_PORT "led[2]" IO_TYPE=LVCMOS15 DRIVE=4;
IO_PORT "led[3]" IO_TYPE=LVCMOS15 DRIVE=4;

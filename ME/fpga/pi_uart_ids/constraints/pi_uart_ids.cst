IO_LOC "clk" T9;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "rst_n" B16;
IO_PORT "rst_n" IO_TYPE=LVCMOS15 PULL_MODE=UP;
// Sole Pi-FPGA UART: GPIO14/TXD0 -> C17; GPIO15/RXD0 <- G14.
IO_LOC "uart_pi_rx" C17;
IO_PORT "uart_pi_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "uart_pi_tx" G14;
IO_PORT "uart_pi_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "led[0]" D14; IO_LOC "led[1]" C14; IO_LOC "led[2]" B9; IO_LOC "led[3]" A9;
IO_PORT "led[0]" IO_TYPE=LVCMOS15 DRIVE=4;
IO_PORT "led[1]" IO_TYPE=LVCMOS15 DRIVE=4;
IO_PORT "led[2]" IO_TYPE=LVCMOS15 DRIVE=4;
IO_PORT "led[3]" IO_TYPE=LVCMOS15 DRIVE=4;

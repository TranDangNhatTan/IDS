<mxfile host="app.diagrams.net" modified="2026-10-18T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="overview" name="Mô hình hệ thống tổng thể">
    <mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="SƠ ĐỒ KHỐI KIẾN TRÚC TỔNG THỂ HỆ THỐNG PHÁT HIỆN XÂM NHẬP MẠNG TĂNG TỐC BẰNG FPGA" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=18;fontColor=#003366;" vertex="1" parent="1"><mxGeometry x="130" y="20" width="900" height="35" as="geometry"/></mxCell>
        <mxCell id="source" value="NGUỒN DỮ LIỆU LƯU LƯỢNG MẠNG&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;PC phát lại NSL-KDD / CICIDS-2017&lt;br&gt;hoặc Ethernet thực tế&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="175" height="100" as="geometry"/></mxCell>
        <mxCell id="interface" value="KHỐI GIAO TIẾP ĐẦU VÀO&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Ethernet / UART RX&lt;br&gt;Đồng bộ frame, kiểm tra dữ liệu&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="250" y="165" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="power" value="KHỐI NGUỒN&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Nguồn vào 5 V; ổn áp 3.3 V&lt;br&gt;Bảo vệ nguồn, lọc nhiễu&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="250" y="335" width="180" height="85" as="geometry"/></mxCell>
        <mxCell id="fpga" value="FPGA GOWIN – LÕI XỬ LÝ IDS TĂNG TỐC PHẦN CỨNG" style="swimlane;html=1;rounded=1;fontStyle=1;fontSize=15;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="485" y="85" width="370" height="445" as="geometry"/></mxCell>
        <mxCell id="parser" value="Packet / Feature Parser&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Tách trường Ethernet, IPv4, TCP/UDP&lt;br&gt;hoặc nhận 28 raw feature từ MCU/host&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="fpga"><mxGeometry x="25" y="55" width="320" height="60" as="geometry"/></mxCell>
        <mxCell id="flow" value="Flow Table / BRAM Manager&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Quản lý flow, packet count, byte count, timestamp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="fpga"><mxGeometry x="25" y="135" width="320" height="55" as="geometry"/></mxCell>
        <mxCell id="feature" value="Feature Extractor và Quantizer&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Mã hóa 28 đặc trưng; lượng tử hóa số nguyên / Q0.16&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="fpga"><mxGeometry x="25" y="210" width="320" height="55" as="geometry"/></mxCell>
        <mxCell id="engine" value="AI/ML Hardware Accelerator&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Decision Tree engine: Node ROM + Decoder + FSM&lt;br&gt;Phân loại Normal hoặc Attack class ID&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="fpga"><mxGeometry x="25" y="285" width="320" height="70" as="geometry"/></mxCell>
        <mxCell id="decision" value="Decision, Alert Manager &amp; Statistics Logger&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Sinh cảnh báo; đếm packet/flow/attack; lưu trạng thái&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="fpga"><mxGeometry x="25" y="375" width="320" height="50" as="geometry"/></mxCell>
        <mxCell id="localalert" value="KHỐI CẢNH BÁO CỤC BỘ&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;LED trạng thái; buzzer cảnh báo&lt;br&gt;Relay mô phỏng Block/Allow&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="930" y="260" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="mcu" value="SONIX MCU – FIRMWARE / APPLICATION CONTROL&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Giao tiếp SPI với FPGA; nhận class ID, trạng thái và thống kê&lt;br&gt;Điều khiển TFT/OLED, LED, buzzer, relay; đọc cảm biến và nút nhấn&lt;br&gt;Gửi lệnh cấu hình, reset, Block/Allow đến FPGA&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="585" width="325" height="110" as="geometry"/></mxCell>
        <mxCell id="hmi" value="HMI CẢM ỨNG 5–7 INCH / TFT LCD-OLED&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Dashboard tại chỗ; trạng thái hệ thống&lt;br&gt;Normal / Attack; nhật ký cảnh báo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="900" y="570" width="220" height="95" as="geometry"/></mxCell>
        <mxCell id="iot" value="ESP32 IoT GATEWAY&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Wi-Fi / MQTT / HTTP&lt;br&gt;Gửi log cảnh báo; kết nối server&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="900" y="420" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="cloud" value="DASHBOARD / SERVER / CLOUD&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Web dashboard; FastAPI / MQTT broker&lt;br&gt;Database / log storage; giám sát từ xa&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1170" y="420" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="sensor" value="Cảm biến nhiệt độ / Tamper switch&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Giám sát điều kiện và can thiệp vật lý&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="600" width="180" height="65" as="geometry"/></mxCell>
        <mxCell id="legend" value="Màu xanh: đã có mô phỏng/kiểm chứng. Nét đứt: định hướng mở rộng, chưa triển khai thực nghiệm." style="text;html=1;align=center;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="340" y="740" width="700" height="25" as="geometry"/></mxCell>
        <mxCell id="e1" style="endArrow=block;html=1;" edge="1" parent="1" source="source" target="interface"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;" edge="1" parent="1" source="interface" target="parser"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;" edge="1" parent="fpga" source="parser" target="flow"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="endArrow=block;html=1;" edge="1" parent="fpga" source="flow" target="feature"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="endArrow=block;html=1;" edge="1" parent="fpga" source="feature" target="engine"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="endArrow=block;html=1;" edge="1" parent="fpga" source="engine" target="decision"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="endArrow=block;html=1;" edge="1" parent="1" source="decision" target="localalert"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="SPI: kết quả / lệnh" style="endArrow=block;startArrow=block;html=1;dashed=1;" edge="1" parent="1" source="decision" target="mcu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="endArrow=block;html=1;dashed=1;" edge="1" parent="1" source="sensor" target="mcu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="endArrow=block;html=1;dashed=1;" edge="1" parent="1" source="mcu" target="hmi"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" style="endArrow=block;html=1;dashed=1;" edge="1" parent="1" source="mcu" target="iot"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" style="endArrow=block;html=1;dashed=1;" edge="1" parent="1" source="iot" target="cloud"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" style="endArrow=block;html=1;dashed=1;" edge="1" parent="1" source="power" target="interface"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" style="endArrow=block;html=1;dashed=1;" edge="1" parent="1" source="power" target="mcu"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="layers" name="Kiến trúc phần cứng – phần mềm">
    <mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="KIẾN TRÚC PHẦN CỨNG – PHẦN MỀM CỦA HỆ THỐNG IDS" style="text;html=1;align=center;fontStyle=1;fontSize=20;fontColor=#003366;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="680" height="30" as="geometry"/></mxCell>
        <mxCell id="training" value="TẦNG PHẦN MỀM HUẤN LUYỆN (PC)&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;NSL-KDD → tiền xử lý, mã hóa, lượng tử hóa → Decision Tree (Python/Scikit-learn)&lt;br&gt;Xuất artifact: HDF5 / CSV / node_rom.mem / golden vectors&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="120" y="100" width="930" height="90" as="geometry"/></mxCell>
        <mxCell id="deployment" value="TẦNG TRIỂN KHAI FPGA GOWIN (đã mô phỏng/kiểm chứng)&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Input Ethernet/raw feature → Parser &amp; Flow table → Feature quantizer → Node ROM + Tree FSM → class ID / cảnh báo&lt;br&gt;Kiểm chứng parity giữa Python integer evaluator, ROM evaluator và Verilog RTL.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="120" y="270" width="930" height="105" as="geometry"/></mxCell>
        <mxCell id="control" value="TẦNG ĐIỀU KHIỂN SONIX MCU (định hướng mở rộng)&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;SPI với FPGA; tiếp nhận class ID/statistics; điều khiển HMI, LED, buzzer, relay; đọc cảm biến/tamper/nút nhấn; gửi cấu hình, reset và Block/Allow.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="120" y="455" width="930" height="100" as="geometry"/></mxCell>
        <mxCell id="service" value="TẦNG HIỂN THỊ VÀ DỊCH VỤ (định hướng mở rộng)&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;TFT LCD/OLED tại chỗ → ESP32 Wi-Fi/MQTT/HTTP → Dashboard / Server / Cloud; hiển thị trạng thái, cảnh báo và nhật ký sự kiện.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="120" y="635" width="930" height="90" as="geometry"/></mxCell>
        <mxCell id="a1" value="Mô hình đã huấn luyện và ảnh ROM" style="endArrow=block;html=1;" edge="1" parent="1" source="training" target="deployment"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" value="class ID, thống kê / cấu hình, Block-Allow" style="endArrow=block;startArrow=block;html=1;dashed=1;" edge="1" parent="1" source="deployment" target="control"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" value="trạng thái, nhật ký và cảnh báo" style="endArrow=block;html=1;dashed=1;" edge="1" parent="1" source="control" target="service"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
